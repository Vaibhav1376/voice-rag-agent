# ==============================================================================
# Voice RAG Agent - Environment Configuration
# ==============================================================================

# OpenAI API Key (Required for GPT-4o Agent reasoning and Speech/TTS generation)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Qdrant Vector Database URL
# Options:
#  - Local Docker: http://localhost:6333
#  - Qdrant Cloud: https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333
#  - Fast In-Memory (No setup required): :memory:
QDRANT_URL=http://localhost:6333

# Qdrant API Key (Required for Qdrant Cloud; leave empty if using local Docker or :memory:)
QDRANT_API_KEY=your_qdrant_api_key_here

# Default TTS Voice
# Available options: alloy, ash, ballad, coral, echo, fable, onyx, nova, sage, shimmer, verse
DEFAULT_VOICE=coral
